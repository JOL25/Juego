{
  "name": "nightfall-survivors",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-standalone.js",
    "build:crazygames": "node scripts/build-standalone.js --crazygames",
    "test:standalone": "npm run build && node scripts/browser-smoke.js --standalone",
    "start": "node scripts/dev-server.js",
    "test": "node --test",
    "test:browser": "node scripts/browser-smoke.js",
    "test:devices": "npm run build:crazygames && node scripts/browser-device-qa.js",
    "test:engines": "npm run build:crazygames && node scripts/browser-engine-qa.js",
    "benchmark": "node scripts/performance-benchmark.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0"
  }
}
